# 이 파일을 복사해 .env 를 만들고 실제 값을 넣습니다.  (cp .env.example .env)
# .env 는 Git에 올리지 않습니다.

# ── Django ──────────────────────────────
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# python manage.py runserver 기본 포트 (8000을 다른 프로그램이 쓰면 변경)
DJANGO_PORT=8000

# ── PostgreSQL ──────────────────────────
POSTGRES_DB=vision_action
POSTGRES_USER=vision
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
# 컴퓨터에서 접속할 포트 (다른 프로젝트와 겹치면 변경)
POSTGRES_PORT=5432

# ── Redis · Celery ──────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ── FastAPI (AI 서버) ───────────────────
AI_SERVICE_URL=http://localhost:8001
AI_REQUEST_TIMEOUT=120
# 이 값보다 Confidence가 낮으면 "판단 불확실" 표시
UNCERTAIN_CONFIDENCE=0.40

# ── IP Webcam ───────────────────────────
# 허용할 카메라 주소 (쉼표로 구분)
ALLOWED_CAMERA_URLS=http://192.168.0.10:4747/video
CAMERA_CAPTURE_SECONDS=8
# 분석 시작 → 녹화 전 준비 시간 (촬영 위치로 이동)
CAMERA_PREPARE_SECONDS=5
# 카메라 중계: Worker 가 Django 중계에서 화면을 받음 (브라우저 미리보기와 공유)
# 로컬 개발은 runserver 주소, Docker 는 compose.yaml 에서 http://django:8000 으로 덮어씀
CAMERA_RELAY_BASE=http://127.0.0.1:8000
CAMERA_RELAY_TOKEN=change-me-random-string
# 화면 회전(시계 방향 0/90/180/270): 휴대폰을 세워 찍으면 DroidCam 화면이 옆으로 누움 → 90
CAMERA_ROTATION=0

# ── Docker Compose (컴퓨터 쪽 공개 포트) ─────────
WEB_PORT=8080
AI_PORT=8001
